# Chỉ dùng cho local. Không sao chép giá trị này sang staging/production.
POSTGRES_DB=dove_field
POSTGRES_USER=dove_local
POSTGRES_PASSWORD=local-only-change-me
DATABASE_URL=postgresql://dove_local:local-only-change-me@127.0.0.1:5432/dove_field

MINIO_ROOT_USER=dove_local
MINIO_ROOT_PASSWORD=local-only-change-me-too
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=dove-evidence-local

API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info

# Tài khoản giả dành riêng cho local/test. Phải thay bằng secret manager ngoài local.
BOOTSTRAP_OWNER_EMAIL=owner@example.local
BOOTSTRAP_OWNER_PASSWORD=local-demo-password
BOOTSTRAP_OWNER_NAME=Chủ hồ sơ local
SESSION_TTL_HOURS=12
COOKIE_SECURE=false
LOGIN_REQUESTS_PER_MINUTE=5

# Nền MapLibre tùy chọn. Chỉ dùng style URL được cấp phép và public browser token
# đã giới hạn domain/API/quota. Để trống để dùng nền kỹ thuật local.
VITE_BASEMAP_STYLE_URL=
VITE_BASEMAP_LABEL=
VITE_BASEMAP_ATTRIBUTION=

# Định tuyến local xác định không gọi mạng. Production có thể đổi sang mapbox và
# cấp MAPBOX_ACCESS_TOKEN từ secret manager; không commit token thật.
ROUTING_PROVIDER=local
MAPBOX_ACCESS_TOKEN=
ROUTING_TIMEOUT_MS=8000
ROUTING_REQUESTS_PER_MINUTE=30
