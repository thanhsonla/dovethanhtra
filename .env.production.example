# Mẫu cấu hình môi trường Cloud / Staging / Production.
# KHÔNG lưu mật khẩu hoặc token thật vào Git repository!

# 1. Supabase PostgreSQL Database (Bắt buộc TLS/SSL)
# Lấy URL trực tiếp từ Supabase Dashboard -> Project Settings -> Database -> Connection string (Direct connection / Transaction pooler)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# 2. Object Storage (Cloudflare R2 hoặc S3-compatible)
# Dùng cho lưu trữ ảnh hiện trường và tệp xuất báo cáo
S3_ENDPOINT=https://[YOUR-ACCOUNT-ID].r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=[YOUR-R2-ACCESS-KEY]
S3_SECRET_ACCESS_KEY=[YOUR-R2-SECRET-KEY]
S3_BUCKET=dove-evidence-production
S3_USE_SSL=true

# 3. Quét mã độc (ClamAV Service)
CLAMAV_HOST=dove-clamav-service
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000

# 4. API Server Runtime
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=https://your-app.vercel.app

# 5. Xác thực & Session
SESSION_SECRET=[RANDOM-64-CHAR-HEX-STRING]
COOKIE_SECRET=[RANDOM-64-CHAR-HEX-STRING]
BOOTSTRAP_OWNER_EMAIL=admin@yourdomain.gov.vn
BOOTSTRAP_OWNER_PASSWORD=[SECURE-GENERATED-PASSWORD]
BOOTSTRAP_OWNER_NAME=Quản trị viên Hệ thống
SESSION_TTL_HOURS=12
COOKIE_SECURE=true
LOGIN_REQUESTS_PER_MINUTE=5

# 6. Bản đồ & Bản đồ nền (Frontend Web / Vercel)
# VITE_* được nhúng trực tiếp vào bundle Vercel
VITE_MAPBOX_PUBLIC_TOKEN=pk.eyJ1IjoieW91ci11c2VyIiwiYSI6ImN...
VITE_BASEMAP_STYLE_URL=mapbox://styles/mapbox/satellite-streets-v12
VITE_BASEMAP_LABEL=Vệ tinh Mapbox + địa danh
VITE_BASEMAP_ATTRIBUTION=© Mapbox © OpenStreetMap

# 7. Định tuyến & Google Map Tiles (Backend API secret)
ROUTING_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=sk.eyJ1IjoieW91ci11c2VyIiwiYSI6ImN...
GOOGLE_MAP_TILES_API_KEY=AIzaSy...
