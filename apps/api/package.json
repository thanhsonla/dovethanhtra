{
  "name": "@dove/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "node-pg-migrate --migrations-dir ../../database/migrations --database-url-var DATABASE_URL up",
    "db:migrate:down": "node-pg-migrate --migrations-dir ../../database/migrations --database-url-var DATABASE_URL down 1",
    "db:test:create": "tsx src/scripts/prepare-test-database.ts",
    "db:admin-area:import": "tsx src/scripts/import-admin-areas.ts",
    "db:admin-area:normalize-coverage": "tsx src/scripts/normalize-admin-area-coverage.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:deploy:supabase": "tsx src/scripts/deploy-supabase-db.ts",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@dove/contracts": "workspace:*",
    "@fastify/cookie": "11.1.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.0",
    "@node-rs/argon2": "2.0.2",
    "@sinclair/typebox": "catalog:",
    "exceljs": "4.4.0",
    "fastify": "5.10.0",
    "kysely": "0.29.4",
    "minio": "8.0.7",
    "pg": "8.22.0",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "8.18.0",
    "node-pg-migrate": "9.0.0",
    "tsx": "4.23.1",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
